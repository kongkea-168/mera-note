{
  "name": "mera-note",
  "version": "1.0.0",
  "type": "module",
  "description": "A lightweight, always-on-top Khmer-language desktop sticky note built with Electron and React.",
  "author": "K. Sothea",
  "license": "Apache-2.0",
  "homepage": "https://github.com/k-sothea/mera-note#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/k-sothea/mera-note.git"
  },
  "bugs": {
    "url": "https://github.com/k-sothea/mera-note/issues"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "sticky-note",
    "khmer",
    "cambodia",
    "desktop-app",
    "productivity",
    "always-on-top"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder --mac --win",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:renderer": "vite build",
    "test": "npm run build:renderer && node --test tests/*.test.mjs",
    "verify": "npm run lint && npm test && npm audit --audit-level=low"
  },
  "build": {
    "appId": "com.meranote.app",
    "productName": "MERA Note",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@fontsource/suwannaphum": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.91.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  }
}
